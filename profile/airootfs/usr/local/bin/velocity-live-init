#!/usr/bin/env bash
# Velocity Linux live welcome. Runs once on tty1 after autologin.
set -uo pipefail

V=$'\e[38;2;124;92;255m'   # violet
C=$'\e[38;2;34;211;238m'   # cyan
D=$'\e[38;2;140;140;160m'  # dim
B=$'\e[1m'
R=$'\e[0m'

clear
printf '\n%s' "${V}"
cat <<'EOF'
  ██╗   ██╗███████╗██╗      ██████╗  ██████╗██╗████████╗██╗   ██╗
  ██║   ██║██╔════╝██║     ██╔═══██╗██╔════╝██║╚══██╔══╝╚██╗ ██╔╝
  ██║   ██║█████╗  ██║     ██║   ██║██║     ██║   ██║    ╚████╔╝
  ╚██╗ ██╔╝██╔══╝  ██║     ██║   ██║██║     ██║   ██║     ╚██╔╝
   ╚████╔╝ ███████╗███████╗╚██████╔╝╚██████╗██║   ██║      ██║
    ╚═══╝  ╚══════╝╚══════╝ ╚═════╝  ╚═════╝╚═╝   ╚═╝      ╚═╝
EOF
printf '%s%s%s  Arch-based. Yours from the first boot.%s\n\n' "${R}" "${C}" "${B}" "${R}"
printf '%s  Live session · root, no password · Wi-Fi: %snmtui%s or %siwctl%s\n\n' "${D}" "${R}" "${D}" "${R}" "${R}"
printf '  %svelocity-install%s   Guided installer (disk, desktop, apps, theme)\n' "${B}" "${R}"
printf '  %svelocity%s           The customizer. Pick desktops, themes, app bundles.\n' "${B}" "${R}"
printf '  %svelocity doctor%s    Hardware and network check\n' "${B}" "${R}"
printf '  %sInstallation_guide%s Manual install notes\n\n' "${B}" "${R}"

# Compact hardware summary
if command -v fastfetch >/dev/null 2>&1; then
  fastfetch --logo none --structure "OS:Kernel:CPU:GPU:Memory:Disk" 2>/dev/null | sed 's/^/  /'
  echo
fi
