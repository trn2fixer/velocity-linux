/* Velocity · rofi */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg:      #0b0b12ee;
    bg-alt:  #14141f;
    fg:      #e6e6f0;
    dim:     #8c8ca0;
    accent:  #7c5cff;
    accent2: #22d3ee;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    padding: 16px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 10px 14px;
    margin: 0 0 12px 0;
}
prompt { text-color: @accent; margin: 0 10px 0 0; }
entry { placeholder: "Search…"; placeholder-color: @dim; }

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
}
element-icon { size: 24px; margin: 0 10px 0 0; }
element selected {
    background-color: @accent;
    text-color: #0b0b12;
}
element-text { vertical-align: 0.5; }
